  "doc": {
    "0000": "Release far buffers, close MSG.DBS/SCENARIO.DBS, stop sound and restore video, depending on how far startup got.",
    "00d5": "Clean up and exit to DOS with the given code.",
    "011a": "Allocate a window struct (w,h,x,y,color,flags,cursor,border chars), link it into the window list, clear it, optionally refresh.",
    "02d2": "Unlink and free a window, optionally refreshing the screen.",
    "030b": "Set a window's cursor column/row (wrapped to window size).",
    "0396": "Print spaces until the cursor reaches the given column.",
    "0453": "Convert a signed long to a decimal string.",
    "0507": "Print a long right-aligned in a field of the given width.",
    "05c1": "Replace the first occurrence of a char in str with another string.",
    "063a": "Binary-search the message index for the entry containing a message number.",
    "06aa": "Load a 1K MSG.DBS block into the current buffer, using a 4-block cache.",
    "075b": "Fetch message number N from MSG.DBS and decode it into a buffer.",
    "083f": "Fetch message N and print it into a window with a color.",
    "0882": "Read (0) or write (1) one record of a given type from SCENARIO.DBS, decoding packed types.",
    "09a3": "Wait up to N seconds, returning early if Enter is pressed.",
    "09e2": "Return a random number 0..n-1 (0 if n<=0).",
    "0aaa": "Play a sound effect, honoring the sound setting.",
    "0b7e": "Print a string centered on a 40-column row.",
    "0bd8": "Poll the mouse against the click-region table; returns region, sets click flag if negative.",
    "0c16": "Set click region i to the rectangle x1,y1,x2,y2 (255 ends the table).",
    "0c42": "Return whether the mouse was clicked anywhere on the screen.",
    "0cd6": "Build drive/path prefix plus a file name in a static buffer.",
    "0d26": "Show 'INSERT DISK' window and wait until the right disk (DISK.HDR) is present; reopen data files.",
    "1124": "Make sure the disk needed for an action is inserted.",
    "1462": "PC-speaker/timer sound player (programs PIT and hooks IRQ0).",
    "1c14": "Detect display, load its .drv driver, allocate buffers and detect the mouse.",
    "1f41": "Load the display driver file (ega/cga/herc/tandy.drv).",
    "22b7": "Put a character at the window cursor with a color and advance.",
    "24e9": "Print a zero-terminated string into a window with a color.",
    "2643": "Return 1 if a key (of the requested class) is waiting.",
    "2724": "Read a key, mapping arrow keys to 8..11.",
    "2881": "Set or clear bit N in a bit array.",
    "28af": "Return bit N of a bit array.",
    "28da": "Store a width-bit value at index N in a packed array.",
    "2925": "Get the width-bit value at index N from a packed array.",
    "2962": "Return (value >> shift) masked to width bits.",
    "29d9": "Decode Huffman-compressed text into a zero-terminated string.",
    "2a63": "Redraw all windows to the screen.",
    "3350": "Return the index of a char in a string, or -1.",
    "3384": "Return the index of a substring in a string, or -1.",
    "3640": "Stop any playing sound."
  },
